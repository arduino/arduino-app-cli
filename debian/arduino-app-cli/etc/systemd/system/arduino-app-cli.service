[Unit]
Description=Arduino App CLI daemon Service
After=network-online.target docker.service arduino-router.service
Wants=network-online.target docker.service arduino-router.service

[Service]
ExecStart=/usr/bin/arduino-app-cli daemon --port 8800 --log-level debug
User=1000
Group=arduino
Environment="DOCKER_REGISTRY_BASE=ghcr.io/rjtokenring/"
Environment="DOCKER_PYTHON_BASE_IMAGE=app-bricks/python-apps-base:dev-latest"
Environment="ARDUINO_ROUTER_SOCKET=/var/run/arduino-router.sock"
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
