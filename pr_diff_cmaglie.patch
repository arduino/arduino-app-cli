--- /dev/null
+++ b/internal/arduino/builder/internal/detector/cache.go
@@ -0,0 +1,168 @@
+// This file is part of arduino-cli.
+//
+// Copyright 2024 ARDUINO SA (http://www.arduino.cc/)
