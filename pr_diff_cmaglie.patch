+  *         @arg @ref LL_ADC_INJ_TRIG_EXT_LPTIM2_OUT
+  *         @arg @ref LL_ADC_INJ_TRIG_EXT_LPTIM3_OUT
+  */
+static inline uint32_t LL_ADC_INJ_GetTriggerSource(const ADC_TypeDef *ADCx)
+{
