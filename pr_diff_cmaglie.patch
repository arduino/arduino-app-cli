 func NormalizeUTF8(buf []byte) []byte {
 	t := transform.Chain(norm.NFD, runes.Remove(runes.In(unicode.Mn)), norm.NFC)
 	result, _, _ := transform.Bytes(t, buf)
 	return result
 }
 
