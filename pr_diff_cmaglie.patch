+ *             cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>,
+ *                        <&gpio2 20 GPIO_ACTIVE_LOW>;
+ *     };
+ *
+ *     spi2: spi@... {
+ *             compatible = "vnd,spi";
+ *     };
+ *
+ * Example usage:
+ *
+ *     DT_SPI_NUM_CS_GPIOS(DT_NODELABEL(spi1)) // 2
+ *     DT_SPI_NUM_CS_GPIOS(DT_NODELABEL(spi2)) // 0
